{
	"project": {
		"name": "aerialdb",
		"version": "0.0.1",
		"type": "module",
		"updated": "2026-05-30",
		"packageManager": "npm",
		"engines": {
			"node": ">=18.0.0"
		},
		"stack": [
			"SvelteKit 2",
			"Svelte 5 runes",
			"TailwindCSS v4",
			"Drizzle ORM",
			"SQLite/libsql local",
			"Cloudflare Pages",
			"Cloudflare D1",
			"Cloudflare R2",
			"Paraglide JS",
			"Vitest",
			"Playwright"
		]
	},
	"commands": {
		"development": {
			"dev": "npm run dev",
			"build": "npm run build",
			"preview": "npm run preview"
		},
		"quality": {
			"check": "npm run check",
			"lint": "npm run lint",
			"format": "npm run format"
		},
		"testing": {
			"unitWatch": "npm run test:unit",
			"unitOnce": "npm run test:unit -- --run",
			"e2e": "npm run test:e2e",
			"all": "npm test"
		},
		"database": {
			"push": "npm run db:push",
			"generate": "npm run db:generate",
			"migrate": "npm run db:migrate",
			"studio": "npm run db:studio",
			"seed": "npm run db:seed",
			"init": "npm run db:init"
		}
	},
	"source": {
		"routes": "src/routes",
		"components": "src/lib/components",
		"server": "src/lib/server",
		"schema": "src/lib/server/db/schema.ts",
		"dbFactory": "src/lib/server/db/index.ts",
		"toonParser": "src/lib/utils/toon-parser.ts",
		"messages": "messages",
		"cloudflare": "wrangler.toml"
	},
	"database": {
		"accessPattern": "Use getDb(event) in route files; use db export only for local scripts.",
		"tables": {
			"user": ["id", "age", "username", "password_hash", "role"],
			"session": ["id", "user_id", "expires_at"],
			"categories": ["id", "name", "created_at"],
			"moves": [
				"id",
				"name",
				"category_id",
				"description",
				"image_url",
				"video_url",
				"level",
				"contributor_name",
				"created_by",
				"created_at",
				"updated_at"
			]
		},
		"indexes": [
			"moves_name_idx",
			"moves_category_id_idx",
			"moves_level_idx",
			"moves_created_at_idx"
		]
	},
	"routes": [
		{
			"path": "/",
			"methods": ["GET"],
			"auth": "public",
			"purpose": "Move library with search and filters"
		},
		{
			"path": "/admin",
			"methods": ["GET"],
			"auth": "user required by layout",
			"purpose": "Admin move dashboard"
		},
		{
			"path": "/admin/categories",
			"methods": ["GET", "POST actions"],
			"auth": "user required; actions re-check",
			"purpose": "Category management"
		},
		{
			"path": "/admin/moves/[id]/edit",
			"methods": ["GET", "POST actions"],
			"auth": "user required; actions re-check",
			"purpose": "Edit or delete move"
		},
		{
			"path": "/admin/moves/new",
			"methods": ["GET", "POST action"],
			"auth": "user required; action re-check",
			"purpose": "Create move"
		},
		{
			"path": "/api/search",
			"methods": ["GET"],
			"auth": "public",
			"purpose": "JSON move search"
		},
		{
			"path": "/api/test-db",
			"methods": ["GET"],
			"auth": "admin required",
			"purpose": "Database connectivity check"
		},
		{
			"path": "/api/upload",
			"methods": ["POST"],
			"auth": "admin required",
			"purpose": "R2 image upload"
		},
		{
			"path": "/auth/login",
			"methods": ["GET", "POST action"],
			"auth": "anonymous redirects home",
			"purpose": "Login and session creation"
		},
		{
			"path": "/auth/logout",
			"methods": ["POST"],
			"auth": "optional session",
			"purpose": "Session invalidation"
		},
		{
			"path": "/auth/signup",
			"methods": ["GET", "POST action"],
			"auth": "anonymous redirects home",
			"purpose": "Registration and session creation"
		},
		{
			"path": "/community",
			"methods": ["GET"],
			"auth": "public",
			"purpose": "Coming-soon community page"
		},
		{
			"path": "/moves/[id]",
			"methods": ["GET"],
			"auth": "public",
			"purpose": "Move detail page"
		},
		{
			"path": "/theory",
			"methods": ["GET"],
			"auth": "public",
			"purpose": "Coming-soon theory page"
		},
		{
			"path": "/tutorials",
			"methods": ["GET"],
			"auth": "public",
			"purpose": "Coming-soon tutorials page"
		},
		{
			"path": "/upload",
			"methods": ["GET"],
			"auth": "user via UI link",
			"purpose": "Upload/create move UI"
		}
	],
	"components": [
		"FilterChips.svelte",
		"Header.svelte",
		"HeroBanner.svelte",
		"MoveCard.svelte",
		"SearchBar.svelte",
		"YouTubeFacade.svelte"
	],
	"docs": {
		"agentGuidelines": "AGENTS.md",
		"apiContracts": "src/routes/api/README.md",
		"componentRegistry": "src/lib/components/README.md",
		"toonFormat": "mdocs/TOON_FORMAT.md",
		"securityLessons": ".Jules/sentinel.md",
		"cloudflareDeployment": "mdocs/CLOUDFLARE_DEPLOYMENT.md"
	}
}
